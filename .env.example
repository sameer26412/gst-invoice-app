# Change this before using the app on a shared network.
ADMIN_PASSWORD=replace-this-with-a-long-random-password

# Fixed QR destination. Localhost works only on the same computer.
# For phones on the same Wi-Fi, use your PC LAN IP, e.g. http://192.168.1.25:8501
# For public customer access, use your deployed HTTPS URL.
PUBLIC_APP_URL=http://localhost:8501

# Optional: Google Cloud Translation API key for one-click invoice translation.
GOOGLE_TRANSLATE_API_KEY=

# Optional database path. Defaults to ./data/invoices.db
# DATABASE_PATH=data/invoices.db
